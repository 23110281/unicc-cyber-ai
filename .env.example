# =============================================================================
#  UNICC Cyber AI - settings
#
#  HOW TO USE: copy this file to a new file named ".env" (same folder), then
#  fill in the values. ".env" is listed in .gitignore, so it is never uploaded.
#  NEVER put real keys or passwords in this example file - it IS uploaded.
#
#  Lines starting with # are comments. Leave a value empty to use the default.
# =============================================================================

# ---- Security ---------------------------------------------------------------

# Secret key that signs login passes. Anyone who knows it can log in as anyone.
# Make one with:   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If empty, a random key is made at every start (everyone is logged out on restart).
JWT_SECRET=

# How long a login lasts, in minutes.
SESSION_MINUTES=60

# true = the login cookie is only sent over HTTPS. Keep false for http://127.0.0.1,
# set true on any real deployment (which must use HTTPS).
COOKIE_SECURE=false

# Other websites allowed to call this app from a browser (comma-separated).
# Leave empty: the dashboard is served by the app itself and needs no permission.
ALLOWED_ORIGINS=

# Password-guessing limit (failed logins within LOGIN_BLOCK_MINUTES).
LOGIN_MAX_FAILURES_PER_USER=5
# Per computer address. Behind Docker or a proxy every user may share ONE address,
# so either run uvicorn with --proxy-headers, or set this to 0 (off).
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_BLOCK_MINUTES=15

# ---- AI model ---------------------------------------------------------------

# Backend used on the very first start: gemini (API) or ollama (on-premise).
# After that, an admin switches it in the dashboard (System Config).
DEFAULT_LLM_BACKEND=gemini

# Google Gemini (API-based). Get a key at https://aistudio.google.com
GEMINI_API_KEY=
# Model name - check the current list: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.6-flash

# Ollama (on-premise). The model must already be pulled:  ollama pull <model>
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=tinyllama

# ---- Storage ----------------------------------------------------------------

# Database location. Empty = backend/app.db. In Docker use a mounted folder,
# e.g. sqlite:////data/app.db   (four slashes = absolute path)
DATABASE_URL=
